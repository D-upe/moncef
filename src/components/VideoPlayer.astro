---
const { src, poster, title = "Vidéo" } = Astro.props;
---
<div class="video-player">
  <video src={src} poster={poster} controls preload="metadata" muted playsinline>
    Votre navigateur ne supporte pas la vidéo.
  </video>
  <p class="video-title">{title}</p>
</div>

<style>
  .video-player {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #2a2a2e;
    background: var(--coal);
  }
  .video-player video {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .video-title {
    text-align: center;
    color: var(--gold-soft);
    font-size: 0.85rem;
    padding: 0.5rem;
    font-family: system-ui, sans-serif;
  }
</style>
