---
import Base from '../layouts/Base.astro';

const title = 'Galerie — Moncef Benouniche | Violoniste, Acteur — Alger';
const description =
  'Galerie photo et vidéo de Moncef Benouniche : prestations scéniques, cours de violon, série FATMA. Alger & Algérie.';
---
<Base title={title} description={description} path="/galerie/">
  <main class="wrap">
    <div class="hero">
      <div class="hero-particles" aria-hidden="true">
        <span class="particle"></span><span class="particle"></span><span class="particle"></span>
        <span class="particle"></span><span class="particle"></span><span class="particle"></span>
      </div>
      <p class="eyebrow">GALERIE</p>
      <h1>Galerie <em>visuelle</em></h1>
      <div class="rule"></div>
      <p class="lede">Prestations scéniques, cours de violon, coulisses de la série FATMA — Alger &amp; Algérie.</p>
    </div>
    <section class="block" aria-labelledby="t-photos">
      <h2 id="t-photos"><span class="n">01 ·</span> Photos</h2>
      <div class="gallery-grid reveal stagger-1">
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 1" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 2" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 3" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 4" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 5" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Photo 6" width="400" height="250" /></div>
      </div>
    </section>
    <section class="block" aria-labelledby="t-videos">
      <h2 id="t-videos"><span class="n">02 ·</span> Vidéos</h2>
      <div class="video-grid reveal stagger-2">
        <div class="gallery-item"><video src="/media/videos/presentation.mp4" poster="/media/pictures/video-thumb.svg" controls preload="metadata" muted playsinline><p>Votre navigateur ne supporte pas la vidéo.</p></video></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Capture vidéo" width="400" height="250" /></div>
        <div class="gallery-item"><img src="/media/pictures/card-placeholder.svg" alt="Capture vidéo" width="400" height="250" /></div>
      </div>
    </section>
  </main>
</Base>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .gallery-item {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #2a2a2e;
    background: var(--coal);
  }
  .gallery-item img,
  .gallery-item video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .video-grid .gallery-item video {
    aspect-ratio: 16 / 9;
  }
</style>