---
import Base from '../layouts/Base.astro';
import BookingCTA from '../components/BookingCTA.astro';
import ImageCard from '../components/ImageCard.astro';

const title = 'Cours de Violon Alger — Professeur YAMAHA & MELTIN ART | Moncef Benouniche';
const description =
  'Cours de violon à Alger pour enfants et adultes, tous niveaux. Professeur chez YAMAHA Algérie & MELTIN ART, cours à domicile. Lecture, interprétation, scène. Contact : 0556 72 89 33.';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Acceptez-vous les débutants complets ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oui — enfants et adultes, tous niveaux, avec suivi des objectifs et des résultats.' },
    },
    {
      '@type': 'Question',
      name: 'Où ont lieu les cours ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Chez YAMAHA Algérie, MELTIN ART et à domicile à Alger.' },
    },
    {
      '@type': 'Question',
      name: 'Faut-il déjà avoir un violon ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Un violon personnel est recommandé — conseils pour bien choisir sur demande.' },
    },
    {
      '@type': 'Question',
      name: 'En quelles langues ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Français, arabe et anglais.' },
    },
  ],
};

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://ohala.qd.je/' },
    { '@type': 'ListItem', position: 2, name: 'Cours de violon Alger', item: 'https://ohala.qd.je/professeur-violon-alger/' },
  ],
};
---
<Base title={title} description={description} path="/professeur-violon-alger/">
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <main class="wrap">
    <div class="hero">
      <div class="hero-particles" aria-hidden="true">
        <span class="particle"></span><span class="particle"></span><span class="particle"></span>
        <span class="particle"></span><span class="particle"></span><span class="particle"></span>
      </div>
      <p class="eyebrow">COURS — ALGER</p>
      <div class="hero-img reveal stagger-1"><img src="/media/pictures/background.jpg" alt="Professeur de violon à Alger" width="800" height="400" /></div>
      <h1 class="reveal stagger-2">Cours de <em>violon à Alger</em></h1>
      <div class="rule reveal stagger-3"></div>
      <p class="lede reveal stagger-4">
        Enfants et adultes, tous niveaux : lecture de partitions, interprétation, performance scénique.
        Professeur chez YAMAHA Algérie &amp; MELTIN ART — suivi des objectifs et des résultats.
      </p>
      <BookingCTA />
    </div>
    <section class="block">
      <h2><span class="n">01 ·</span> Où apprendre</h2>
      <div class="grid reveal stagger-1">
        <div class="card"><img src="/media/pictures/card-placeholder.svg" alt="YAMAHA" width="400" height="250" /><h3>YAMAHA Algérie</h3><p>Cours en institution, programme structuré.</p></div>
        <div class="card"><img src="/media/pictures/card-placeholder.svg" alt="MELTIN ART" width="400" height="250" /><h3>MELTIN ART</h3><p>Ateliers et accompagnement artistique.</p></div>
        <div class="card"><img src="/media/pictures/card-placeholder.svg" alt="À domicile" width="400" height="250" /><h3>À domicile</h3><p>Cours personnalisés à Alger, tous niveaux.</p></div>
      </div>
      <BookingCTA />
    </section>
    <section class="block">
      <h2><span class="n">02 ·</span> Programme &amp; tarifs</h2>
      <dl class="faq reveal stagger-2">
        <dt>Débutants acceptés ?</dt><dd>Oui, enfants et adultes, tous niveaux.</dd>
        <dt>Où ?</dt><dd>YAMAHA Algérie, MELTIN ART, domicile.</dd>
        <dt>Faut-il un violon ?</dt><dd>Recommandé — conseils d'achat sur demande.</dd>
        <dt>Langues ?</dt><dd>Français, arabe, anglais.</dd>
      </dl>
    </section>
  </main>
</Base>
