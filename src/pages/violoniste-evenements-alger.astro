---
import Base from '../layouts/Base.astro';
import BookingCTA from '../components/BookingCTA.astro';

const title = 'Violoniste Événements Alger — Privés, Galas, Séminaires | Moncef Benouniche';
const description =
  'Violoniste pour événements à Alger : soirées privées, galas, séminaires. Références Opéra d’Alger, TEDx Algiers, Union Européenne. Devis : 0556 72 89 33.';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Intervenez-vous pour des séminaires d’entreprise ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oui — cérémonies, galas, lancements et séminaires, avec une formule adaptée au programme.' },
    },
    {
      '@type': 'Question',
      name: 'Quelles sont vos références institutionnelles ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Opéra d’Alger, TEDx Algiers, Union Européenne.' },
    },
    {
      '@type': 'Question',
      name: 'Sonorisation fournie ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Organisation sur devis selon la salle et le public — précisez le lieu à l’appel.' },
    },
  ],
};

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.ohala.qd.je/' },
    { '@type': 'ListItem', position: 2, name: 'Événements Alger', item: 'https://www.ohala.qd.je/violoniste-evenements-alger/' },
  ],
};
---
<Base title={title} description={description} path="/violoniste-evenements-alger/">
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <main class="wrap">
    <div class="hero">
      <p class="eyebrow">ÉVÉNEMENTS — ALGER &amp; ALGÉRIE</p>
      <h1>Violoniste pour <em>événements à Alger</em></h1>
      <div class="rule"></div>
      <p class="lede">
        Privés, galas, séminaires : une prestation live au niveau des plus grandes scènes —
        Opéra d’Alger, TEDx Algiers, Union Européenne.
      </p>
      <BookingCTA />
    </div>
    <section class="block">
      <h2><span class="n">01 ·</span> Formats</h2>
      <div class="grid">
        <div class="card"><h3>Soirées privées</h3><p>Fiançailles, anniversaires, dîners de gala.</p></div>
        <div class="card"><h3>Corporate</h3><p>Séminaires, lancements, cérémonies officielles.</p></div>
        <div class="card"><h3>Scènes</h3><p>Concerts et performances — classique, moderne, international.</p></div>
      </div>
      <BookingCTA />
      <dl class="faq">
        <dt>Séminaires d’entreprise ?</dt><dd>Oui, formule adaptée au programme.</dd>
        <dt>Références ?</dt><dd>Opéra d’Alger, TEDx Algiers, Union Européenne.</dd>
        <dt>Sonorisation ?</dt><dd>Organisée sur devis selon salle et public.</dd>
      </dl>
    </section>
  </main>
</Base>
